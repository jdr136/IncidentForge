# IncidentForge environment configuration
# Copy to .env and fill in real values. Never commit .env.

# ── LLM Provider ────────────────────────────────────────────────────────────
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# ── API Server ───────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────────────────────────
DB_PATH=./data/incidentforge.db

# ── Kubernetes ───────────────────────────────────────────────────────────────
# Populated by: make bootstrap
# Two separate kubeconfig contexts — observer (read-only) and controller (trusted).
KUBECONFIG_OBSERVER=./infra/kind/kubeconfig-observer.yaml
KUBECONFIG_CONTROLLER=./infra/kind/kubeconfig-controller.yaml

# ── AWS Emulator ─────────────────────────────────────────────────────────────
# Populated by: make emulator-up  (do not set manually)
# NEVER point these at real AWS endpoints.
AWS_ENDPOINT_URL=https://127.0.0.1:9297
AWS_CA_BUNDLE=
AWS_SHARED_CREDENTIALS_FILE=
AWS_CONFIG_FILE=
AWS_EC2_METADATA_DISABLED=true
AWS_DISABLE_HOST_PREFIX_INJECTION=true
AWS_REGION=us-east-1
AWS_DEFAULT_REGION=us-east-1

# ── Lab Behaviour ────────────────────────────────────────────────────────────
# lazy   = keep namespace until next run's prepare() cleans it  (default, good for demos)
# immediate = delete on run terminal state
# manual = never auto-delete; use `make clean`
CLEANUP_POLICY=lazy

# ── Investigation Limits ─────────────────────────────────────────────────────
TOOL_BUDGET=12
PREPARATION_TIMEOUT_S=90
MANIFESTATION_TIMEOUT_S=60
INVESTIGATION_TIMEOUT_S=120
VERIFICATION_TIMEOUT_S=90
